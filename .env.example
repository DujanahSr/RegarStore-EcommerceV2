# ==============================================================================
# RegarStore - environment (.env)
# Salin: cp .env.example .env  -> nilai default di bawah langsung jalan secara lokal
# tanpa akun pihak ketiga apa pun (Postgres lokal, Mailpit, Midtrans mode mock).
# ==============================================================================

# --- Database -----------------------------------------------------------------
# Default: Postgres lokal di Docker (profile local-db).
COMPOSE_PROFILES=local-db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase (opsional): hapus COMPOSE_PROFILES di atas, lalu isi dari
# Supabase Dashboard -> Connect -> Transaction pooler
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<password>

# --- Keamanan -----------------------------------------------------------------
# WAJIB diganti di production: string acak minimal 64 karakter hex
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Akun admin dibuat otomatis saat auth-service pertama kali start
ADMIN_EMAIL=admin@regarstore.com
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Admin RegarStore

# --- Message broker -------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Midtrans (pembayaran) ------------------------------------------------------
# Server key yang mengandung "TEST_KEY" = mode mock (Snap token palsu, pembayaran
# disimulasikan lewat webhook ber-signature). Ganti dengan key sandbox asli untuk popup Snap.
MIDTRANS_SERVER_KEY=SB-Mid-server-TEST_KEY_local
MIDTRANS_CLIENT_KEY=SB-Mid-client-TEST_KEY_local
MIDTRANS_IS_PRODUCTION=false

# URL frontend untuk callback Midtrans
FRONTEND_URL=http://localhost:5173

# --- Penyimpanan gambar ---------------------------------------------------------
# Kosong = disimpan lokal (volume Docker). Isi untuk memakai Cloudinary CDN.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Login Google (opsional) ----------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173. Kosong = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=

# --- Email ----------------------------------------------------------------------
# Kosong = Mailpit lokal (inbox di http://localhost:8025).
# Contoh Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_USER=akun@gmail.com
#               MAIL_PASSWORD=<App Password> MAIL_SMTP_AUTH=true MAIL_STARTTLS=true
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
# Alamat pengirim. Gmail selalu memakai alamat akun; Brevo/Resend butuh sender yang sudah diverifikasi.
MAIL_FROM=

# --- Monitoring -----------------------------------------------------------------
# Login Grafana (user: admin) di http://localhost:3001
GRAFANA_PASSWORD=admin

# --- Tunnel publik ngrok (opsional) ---------------------------------------------
# Aktifkan dengan menambah "tunnel" ke COMPOSE_PROFILES (contoh: local-db,tunnel).
# Link frontend & Mailpit dicetak di: docker compose logs ngrok
NGROK_AUTHTOKEN=
# Static domain gratis dari dashboard ngrok -> Domains (tanpa https://)
NGROK_DOMAIN=
# Login untuk Mailpit publik (user:password, password minimal 8 karakter)
NGROK_MAIL_AUTH=
