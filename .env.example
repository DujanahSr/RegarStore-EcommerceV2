# ==============================================================================
# RegarStore - environment PRODUKSI (branch deploy)
# Isi di Dokploy -> Compose -> tab Environment. Jangan commit nilai asli.
# Nilai bertanda <...> wajib diganti.
# ==============================================================================

# --- Database (Supabase -> Connect -> Transaction pooler) -----------------------
# Untuk Postgres di VPS: tambahkan COMPOSE_PROFILES=local-db dan isi DB_HOST=postgres, DB_PORT=5432.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<password-supabase>

# --- Keamanan -----------------------------------------------------------------
# openssl rand -hex 64
JWT_SECRET=<hex-acak-128-karakter>

ADMIN_EMAIL=admin@regarstore.com
ADMIN_PASSWORD=<password-admin-kuat>
ADMIN_NAME=Admin RegarStore

RABBITMQ_USER=regarstore
RABBITMQ_PASSWORD=<password-rabbitmq>

# Login Grafana (user: admin), jika diberi domain di Dokploy
GRAFANA_PASSWORD=<password-grafana>

# --- URL publik -----------------------------------------------------------------
# Domain yang dipasang di tab Domains untuk service frontend (tanpa garis miring di akhir)
FRONTEND_URL=https://<domain>

# --- Midtrans -------------------------------------------------------------------
# Notification URL di dashboard Midtrans: https://<domain>/api/v1/payments/midtrans/webhook
MIDTRANS_SERVER_KEY=<SB-Mid-server-...>
MIDTRANS_CLIENT_KEY=<SB-Mid-client-...>
MIDTRANS_IS_PRODUCTION=false

# --- Penyimpanan gambar (kosong = volume Docker di server) -----------------------
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Login Google ---------------------------------------------------------------
# Authorized JavaScript origins: https://<domain>. Kosong = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=

# --- Email (wajib: registrasi butuh OTP) ----------------------------------------
# Gmail: aktifkan 2FA lalu buat App Password di https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<akun@gmail.com>
MAIL_PASSWORD=<app-password>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Gmail selalu memakai alamat akun; Brevo/Resend butuh sender terverifikasi
MAIL_FROM=<akun@gmail.com>
