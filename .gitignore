# ==========================================
# RegarSport - Root .gitignore
# ==========================================

# --- Environment & Secret Credentials ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
client_secret_*.json

# --- Java & Maven Artifacts ---
**/target/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar

# --- Node.js & Frontend ---
**/node_modules/
**/dist/
**/build/
**/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDEs & Editors ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/

# --- Logs & Crash Dumps ---
*.log
**/*.log
logs/
**/logs/
hs_err_pid*.log
**/hs_err_pid*.log
replay_pid*.log
**/replay_pid*.log

# --- OS System Files ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Local Temporary & Uploads ---
uploads/
temp_*
scratch/
tools/

# --- Tooling lokal ---
.claude/
